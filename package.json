{
  "name": "dsh-superagent-relay",
  "description": "Queue-backed Source kind for dsh-superagent: desktop conversations and dingtalk-cli push messages into one local queue; the engine polls it like any Source.",
  "version": "0.1.0",
  "license": "MIT",
  "author": "Shuai-S",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js"
  },
  "files": [
    "lib",
    "bin"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "bin": {
    "relay-cli": "./bin/relay-cli.mjs"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm build"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "manifestVersion": 1
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@types/node": "^22.20.0",
    "tsdown": "^0.4.0",
    "typescript": "^5.7.0"
  }
}
